# Public address used by Caddy and all OAuth callbacks.
PUBLIC_ORIGIN=https://syncup.ruu.by

# The only host port published by the stack. Keep this aligned with Caddy.
SYNCUP_PORT=8090

# PostgreSQL is provided by the Compose `db` service and is not exposed to the
# host. Do not use localhost here; containers reach it as `db`.
POSTGRES_USER=syncup
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=syncup

# Required in production. Generate with:
# uv run python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SYNCUP_TOKEN_ENCRYPTION_KEY=

# Required for Spotify sign-in.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional integrations.
STEAM_API_KEY=
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TMDB_API_KEY=
LLM_API_KEY=

# Optional hardening and service configuration.
SESSION_SECRET=
REDDIT_USER_AGENT=
MUSICBRAINZ_USER_AGENT=SyncUp/0.1.0
GOOGLE_BOOKS_API_KEY=
